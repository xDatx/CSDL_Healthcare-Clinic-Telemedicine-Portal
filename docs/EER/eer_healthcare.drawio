via" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#B45309;strokeWidth=1.5;fontSize=11;fontStyle=1;fontColor=#1E293B;" vertex="1" parent="1"><mxGeometry x="2842.5" y="1582.0" width="125" height="66" as="geometry"/></mxCell><mxCell id="e298" style="endArrow=none;html=1;rounded=0;strokeColor=#7C3AED;strokeWidth=1.5;" edge="1" parent="1" source="c24" target="c297"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="lbl299" value="1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=12;fontStyle=1;fontColor=#B91C1C;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="e298"><mxGeometry x="-0.65" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="e300" style="shape=link;html=1;rounded=0;strokeColor=#7C3AED;strokeWidth=1.5;endArrow=none;width=5;" edge="1" parent="1" source="c29" target="c297"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="lbl301" value="N" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=12;fontStyle=1;fontColor=#B91C1C;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="e300"><mxGeometry x="-0.65" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="c302" value="EER Diagram — Healthcare Clinic &amp; Telemedicine Portal (Elmasri–Navathe Notation)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=22;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="110.0" y="78.0" width="1020" height="44" as="geometry"/></mxCell><mxCell id="c303" value="&lt;b&gt;Exclusive Arc (NFR-04):&lt;/b&gt;&lt;br&gt;Category &lt;b&gt;AUDIT_ACTOR = PATIENT ∪ DOCTOR ∪ ADMIN&lt;/b&gt;.&lt;br&gt;When mapped to relational tables (Step 9), each log entry stores&lt;br&gt;exactly ONE non-null FK (&lt;code&gt;patient_id&lt;/code&gt; XOR &lt;code&gt;doctor_id&lt;/code&gt; XOR &lt;code&gt;admin_id&lt;/code&gt;)." style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#FFFBEB;strokeColor=#D97706;fontColor=#1E293B;size=14;" vertex="1" parent="1"><mxGeometry x="3355.0" y="1307.5" width="290" height="105" as="geometry"/></mxCell><mxCell id="c304" value="&lt;b&gt;M:N Resolution (BR-16):&lt;/b&gt;&lt;br&gt;Associative entity &lt;b&gt;PRESCRIPTION_ITEM&lt;/b&gt; resolves the M:N&lt;br&gt;relationship &lt;i&gt;lists&lt;/i&gt; between PRESCRIPTION and MEDICATION.&lt;br&gt;Composite PK: &lt;code&gt;(prescription_id, medication_id)&lt;/code&gt;." style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=11;fillColor=#FFFBEB;strokeColor=#D97706;fontColor=#1E293B;size=14;" vertex="1" parent="1"><mxGeometry x="975.0" y="1672.0" width="310" height="86" as="geometry"/></mxCell><mxCell id="c305" value="&lt;b&gt;Legend (Elmasri–Navathe Standards)&lt;/b&gt;&lt;br&gt;&lt;br&gt;▭ &amp;nbsp;&lt;b&gt;Entity&lt;/b&gt; (color-coded by module)&lt;br&gt;▭◇ &lt;b&gt;Associative Entity&lt;/b&gt; (M:N resolution)&lt;br&gt;◯ &amp;nbsp;&lt;b&gt;Attribute&lt;/b&gt; &amp;nbsp;|&amp;nbsp; &lt;u&gt;&lt;b&gt;Key&lt;/b&gt;&lt;/u&gt; = Primary Key&lt;br&gt;◯ &amp;nbsp;&lt;span style=&#x27;color:#7C3AED&#x27;&gt;&lt;b&gt;Composite Attribute&lt;/b&gt;&lt;/span&gt; (&lt;code&gt;vital_signs&lt;/code&gt; → 5 numeric cols)&lt;br&gt;◇ &amp;nbsp;&lt;b&gt;Relationship&lt;/b&gt; &amp;nbsp;|&amp;nbsp; &lt;b style=&#x27;color:#B91C1C&#x27;&gt;1 / N&lt;/b&gt; = Cardinality ratio&lt;br&gt;━ &amp;nbsp;Single line = Partial participation&lt;br&gt;═ &amp;nbsp;Double line = Total (mandatory) participation&lt;br&gt;&lt;b&gt;d&lt;/b&gt; &amp;nbsp;Disjoint Specialization (DOCTOR → GP | SPECIALIST)&lt;br&gt;&lt;b&gt;U&lt;/b&gt; &amp;nbsp;Union Category (AUDIT_ACTOR = PATIENT ∪ DOCTOR ∪ ADMIN)" style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#F8FAFC;strokeColor=#475569;fontColor=#0F172A;size=16;" vertex="1" parent="1"><mxGeometry x="3030.0" y="120.0" width="440" height="220" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>