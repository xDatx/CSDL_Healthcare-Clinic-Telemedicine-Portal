<mxfile host="app.diagrams.net"><diagram name="Physical Diagram (IE Crow's Foot)" id="physical-crows-foot-v2"><mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1820" pageHeight="1700" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p11" value="Physical Database Diagram — IE Crow&#x27;s Foot Notation (MySQL 8.0 DDL)" style="text;html=1;align=left;verticalAlign=middle;fontSize=21;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="70" y="20" width="900" height="36" as="geometry"/></mxCell><mxCell id="p12" value="&lt;b&gt;IE Crow&#x27;s Foot Physical Legend (Appendix A / 17 Tables)&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Solid line&lt;/b&gt;: Identifying / Mandatory non-null FK &amp;nbsp;|&amp;nbsp; &lt;b&gt;Dashed line&lt;/b&gt;: Optional (nullable) FK&lt;br&gt;• &lt;b&gt;||&lt;/b&gt; One &amp;amp; only one &amp;nbsp;|&amp;nbsp; &lt;b&gt;o|&lt;/b&gt; Zero or one &amp;nbsp;|&amp;nbsp; &lt;b&gt;|{&lt;/b&gt; One or many &amp;nbsp;|&amp;nbsp; &lt;b&gt;o{&lt;/b&gt; Zero or many&lt;br&gt;• &lt;b&gt;[AES-256]&lt;/b&gt;: Storage-level TDE tablespace (NFR-04) &amp;nbsp;|&amp;nbsp; &lt;b&gt;vital_signs&lt;/b&gt; flattened to 5 columns (1NF)&lt;br&gt;• &lt;b&gt;Exclusive Arc (NFR-04)&lt;/b&gt;: 3 nullable actor FKs + &lt;code&gt;ck_mr_audit_one_actor (= 1)&lt;/code&gt;" style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10.5;fillColor=#FFFBEB;strokeColor=#D97706;fontColor=#0F172A;size=14;" vertex="1" parent="1"><mxGeometry x="1060" y="15" width="580" height="92" as="geometry"/></mxCell><mxCell id="t13" value="admin" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;fillColor=#475569;strokeColor=#475569;fontColor=#FFFFFF;fontSize=12.5;rounded=0;swimlaneFillColor=#F8FAFC